rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection - User profiles and preferences
    match /users/{userId} {
      allow read, write: if true;
    }

    // Accounts Collection - Authenticated account credentials verification
    match /accounts/{accountId} {
      allow read, write: if true;
    }

    // Contracts Collection
    match /contracts/{contractId} {
      // Allow reading, listing, and querying contracts
      allow read: if true;
      
      // Allow creating, signing, and updating contracts
      allow create, update: if true;
      
      // Allow contract deletion
      allow delete: if true;
    }
  }
}

